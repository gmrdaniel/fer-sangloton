# Copia este archivo como .env y llena los valores.
# En producción se configuran en Vercel → Settings → Environment Variables.

# Registro de pedidos en Google Sheets (api/pedido.js)
GOOGLE_SERVICE_ACCOUNT_EMAIL=nombre@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1AbCdEf...   # lo que va entre /d/ y /edit en la URL de la hoja
GOOGLE_SHEET_TAB=Pedidos
